class Program {
    
    private static Object select(int choice, Object first, Object second) {
        if((choice % 2) == 1)
            return first;
        return second;
    }

    public static void main(String[] args) {
        if(args.length > 0){
            int s = Integer.parseInt(args[0]);
            String ss = (String)select(s, "Monday", "Tuesday");
            System.out.printf("Selected String = %s%n", ss);
            //Auto-boxing - impliciltly converting a primitive type 
            //value to an instance of its wrapper class so that it 
            //can be passed as an Object
            double sd = (double)select(s, 6.75, 4.25);
            System.out.printf("Selected double = %s%n", sd);
            //String ssd = (String)select(s, "Friday", 3.5);
        }
    }
}
